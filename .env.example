# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# --- environment ---
ENVIRONMENT=development

# --- LLM providers, split by task to stay within free tiers.
#     See pipeline/llm_config.py for exactly which component uses which --
#     that file is the source of truth; the vars below are just the keys. ---

# Gemini: careful structured extraction from messy text.
#   pipeline/extract.py, pipeline/canonical.py, pipeline/compat.py (the
#   proposal step only -- pipeline/verify.py stays LLM-free per CLAUDE.md),
#   and the intent parser.
GOOGLE_API_KEY=

# Groq: high-volume / speed-sensitive work.
#   eval/adversarial/ scenario generation, and optionally the explainer
#   agent when demo latency matters.
GROQ_API_KEY=

# Optional per-component overrides -- only needed if a specific component
# should deviate from the defaults in pipeline/llm_config.py (e.g. moving a
# component off Gemini during a live demo if you're close to its per-minute
# free-tier quota). Uncomment and set <COMPONENT>_LLM_PROVIDER (gemini|groq)
# and/or <COMPONENT>_LLM_MODEL. Components: EXTRACTOR, CANONICALIZER,
# COMPAT_PROPOSER, INTENT_PARSER, ADVERSARIAL_GENERATOR, EXPLAINER.
# EXTRACTOR_LLM_PROVIDER=gemini
# EXTRACTOR_LLM_MODEL=gemini-2.5-flash

# --- LangSmith tracing, wired from hour one (see pipeline/tracing.py) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentfront

# --- PostgreSQL (docker-compose service: postgres) ---
POSTGRES_USER=agentfront
POSTGRES_PASSWORD=agentfront
POSTGRES_DB=agentfront
DATABASE_URL=postgresql://agentfront:agentfront@localhost:5432/agentfront

# --- Redis (docker-compose service: redis; surface/idempotency.py guard) ---
REDIS_URL=redis://localhost:6379/0

# --- ChromaDB embedding store (pipeline/canonical.py clustering) ---
CHROMA_PERSIST_DIR=./chroma_data

# --- Razorpay, TEST MODE ONLY (surface/payments.py, scripts/razorpay_smoke.py)
#     Get these from the Razorpay Dashboard > Settings > API Keys, in Test Mode.
#     Never put a live (rzp_live_...) key here. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AP2 Cart Mandate signing, Ed25519 via PyNaCl (surface/mandate.py) ---
# 32-byte seed, hex-encoded. Generate with:
#   python -c "import nacl.signing,binascii; print(binascii.hexlify(nacl.signing.SigningKey.generate()._seed).decode())"
MANDATE_SIGNING_SEED=

# --- API service ---
API_HOST=0.0.0.0
API_PORT=8000
